# Build-time backend origin for the deployed frontend (Vercel).
# Local dev leaves this empty and uses the CRA proxy (package.json "proxy") to :8010.
# On Vercel, set REACT_APP_API_BASE to the hosted Render backend URL, e.g.:
#   REACT_APP_API_BASE=https://driftwatch-backend.onrender.com
REACT_APP_API_BASE=
