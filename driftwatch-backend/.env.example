# DriftWatch backend configuration.
# Copy to .env for local runs. On Render, set these in the dashboard / render.yaml.

# --- Mendr egress (the gateway) ---
# real    -> POST envelopes to the real Mendr edge (production / pitch).
# emulate -> DEV: call the drift-shim directly and heal locally (no control plane needed).
MENDR_MODE=emulate
MENDR_GATEWAY_URL=http://localhost:8080
MENDR_GATEWAY_PROXY_PATH=/api/gateway/proxy

# The controllable upstream behind Mendr (used directly in emulate mode; always used to
# flip the drift switch). In production this is your hosted Koyeb shim URL.
DRIFT_SHIM_URL=http://localhost:8090

# --- CoinGecko (free Demo plan: 100/min, 10k/month, no card, attribution required) ---
# Create a key at https://www.coingecko.com/en/api . Only lives here; forwarded via envelope.
COINGECKO_DEMO_KEY=
COINGECKO_VS_CURRENCY=inr
WATCHLIST_IDS=bitcoin,ethereum,solana,ripple,cardano,dogecoin,polkadot,chainlink,polygon-ecosystem-token,litecoin

# --- Redis (Render Key Value free; disposable) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS: the deployed frontend origin(s) ---
CORS_ALLOW_ORIGINS=http://localhost:3002,http://localhost:3000
